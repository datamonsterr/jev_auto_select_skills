{
  "name": "skill_selector",
  "version": "1.2.1",
  "description": "OtherSkill: hidden categorized skills, free OpenRouter decisions and native harness awareness",
  "main": "index.ts",
  "module": "index.ts",
  "type": "module",
  "bin": {
    "skill_selector": "./index.ts",
    "jev-skill-selector": "./otherskill.ts",
    "otherskill": "./otherskill.ts"
  },
  "scripts": {
    "start": "bun --no-env-file otherskill.ts",
    "setup": "bun --no-env-file otherskill.ts setup",
    "setup:claude": "bun --no-env-file otherskill.ts setup --agent claude",
    "setup:codex": "bun --no-env-file otherskill.ts setup --agent codex",
    "setup:agy": "bun --no-env-file otherskill.ts setup --agent antigravity",
    "setup:opencode": "bun --no-env-file otherskill.ts setup --agent opencode",
    "migrate": "bun run scripts/migrate-skills.ts",
    "test": "bun test tests/ --path-ignore-patterns 'tests/integration/**' --path-ignore-patterns 'tests/e2e/**'",
    "test:golden": "bun run scripts/test-golden.ts",
    "test:complex": "bun run scripts/test-complex.ts",
    "test:benchmark": "bun run scripts/benchmark-online.ts",
    "hook": "bun --no-env-file otherskill.ts find",
    "hook:codex": "bun --no-env-file otherskill.ts find --agent codex",
    "hook:claude": "bun --no-env-file otherskill.ts find --agent claude",
    "assess": "bun run scripts/assess.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build otherskill.ts --target=bun --outfile=.tmp/otherskill.js",
    "test:unit": "bun test tests/ --path-ignore-patterns 'tests/integration/**' --path-ignore-patterns 'tests/e2e/**'",
    "test:integration": "bun test tests/integration",
    "test:e2e": "bun test tests/e2e",
    "test:all": "bun test tests/",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "audit": "bun audit",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "prepare": "[ -e .git ] && git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.71",
    "ai": "^7.0.107",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
