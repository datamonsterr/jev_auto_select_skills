{
  "name": "skill_selector",
  "version": "1.1.0",
  "description": "OtherSkill: hidden categorized skills, free OpenRouter decisions and native harness awareness",
  "main": "index.ts",
  "module": "index.ts",
  "type": "module",
  "bin": {
    "skill_selector": "./index.ts",
    "jev-skill-selector": "./otherskill.ts",
    "otherskill": "./otherskill.ts"
  },
  "scripts": {
    "start": "bun otherskill.ts",
    "setup": "bun otherskill.ts setup",
    "setup:claude": "bun otherskill.ts setup --agent claude",
    "setup:codex": "bun otherskill.ts setup --agent codex",
    "setup:agy": "bun otherskill.ts setup --agent antigravity",
    "setup:opencode": "bun otherskill.ts setup --agent opencode",
    "migrate": "bun run scripts/migrate-skills.ts",
    "test": "bun test tests/",
    "test:golden": "bun run scripts/test-golden.ts",
    "test:complex": "bun run scripts/test-complex.ts",
    "test:benchmark": "bun run scripts/benchmark-online.ts",
    "hook": "bun otherskill.ts find",
    "hook:codex": "bun otherskill.ts find --agent codex",
    "hook:claude": "bun otherskill.ts find --agent claude",
    "assess": "bun run scripts/assess.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build otherskill.ts --target=bun --outfile=.tmp/otherskill.js"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.71",
    "ai": "^7.0.107",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
