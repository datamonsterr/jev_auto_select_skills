{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.tmp",
      "!**/.otherskill",
      "!**/golden_set",
      "!**/tests/fixtures",
      "!**/examples",
      "!**/skills/**/*.md",
      "!**/SKILL.md",
      "!**/bun.lock"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2 },
  "linter": {
    "enabled": true,
    "rules": {
      "suspicious": {
        // Legacy selector and LLM JSON handling use `any` widely; typing is enforced by tsc.
        "noExplicitAny": "off"
      },
      "style": {
        // tsconfig sets noUncheckedIndexedAccess; tests and parsers assert after length checks.
        "noNonNullAssertion": "off"
      }
    }
  },
  "assist": { "enabled": false }
}
