# TypeSafe Jev Decision Model API Key (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional alias
# JEV_API_KEY=your_openrouter_api_key_here

# Jev System One Model Slug
MODEL=~typesafe/jev-latest

# Centralized Skills Bank Path
# Defaults to ~/.agents/skills_bank if not set, or ./skills
SKILLS_BANK_PATH=/home/dat/.agents/skills_bank
