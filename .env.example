# Prefer otherskill setup or config set key --key-env OPENROUTER_API_KEY.
# The CLI also accepts an inherited OPENROUTER_API_KEY. Never commit real keys.
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Model/taxonomy/bank/limits belong in otherskill.config.json, not .env.
# The deprecated flat API accepts MODEL only when it ends in :free.
# MODEL=inception/mercury-decide:free
