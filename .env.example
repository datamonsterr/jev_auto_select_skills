# TypeSafe Jev Decision Model API Key (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional alias
# JEV_API_KEY=your_openrouter_api_key_here

# Jev System One Model Slug
MODEL=~typesafe/jev-latest

# Optional Gemini key used only if a future provider adapter needs it.
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.5-flash-lite

# Skills Directory Configuration
# By default, reads both:
#   1. Agent / workspace skills: ./.agents/jev_skills
#   2. Global user skills: ~/.agents/jev_skills/
#
# Override global skills directory:
# GLOBAL_SKILLS_PATH=~/.agents/jev_skills
#
# Override agent skills directory:
# AGENT_SKILLS_PATH=./.agents/jev_skills
#
# Override all search paths with custom bank:
# SKILLS_BANK_PATH=/path/to/custom/skills

